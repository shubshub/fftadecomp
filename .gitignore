# base ROM and the user's own dump - never commit copyrighted game data
baserom.bin
*.gba

# the split itself: raw runs carved out of the ROM by tools/split.py.
# ~16 MB of extracted game data, regenerated locally from your own dump:
#     make split      (or make regen)   -> files/, asm/ manifest, symbols/
# rebuild.py reads files/ from asm/manifest.json to prove the split is exact.
files/
badges/

# build output
build/
*.o
*.elf
*.map

# tools / downloads
tools/bin/
tools/agbcc/
tools/splat/
tools/objdiff/
tools/mips_to_c/
objdiff.exe
objdiff

# editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
logs/last_run.txt
__pycache__/
*.pyc